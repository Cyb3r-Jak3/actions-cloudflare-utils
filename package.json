{
  "name": "cloudflare-utils-action",
  "version": "2.2.0",
  "description": "GitHub Action for Cloudflare utils",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "package": "ncc build --source-map --minify --license licenses.txt",
    "format": "prettier --write src/*.ts",
    "format-check": "prettier --check src/*.ts",
    "lint": "eslint src/**/*.ts && pnpm run format-check",
    "all": "pnpm run format && pnpm run lint && pnpm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyb3r-Jak3/actions-cloudflare-utils.git"
  },
  "keywords": [
    "actions"
  ],
  "author": "Cyb3r-Jak3",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/tool-cache": "^4.0.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/utils": "^8.67.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^9.39.5",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
